{
  "manifest_version": 3,
  "name": "B站字幕摘录",
  "version": "0.1.3",
  "description": "自定义快捷键开始/停止记录B站视频字幕,一键复制语录。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "B站字幕摘录",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.bilibili.com/*", "https://*.hdslb.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content/hook-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content/core.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ]
}
